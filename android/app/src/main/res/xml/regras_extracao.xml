<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app sai do aparelho, nem em backup na nuvem nem em
     transferência para outro aparelho. A semente cifrada, o histórico e o
     estado do nó só existem aqui; quem restaura usa a frase-semente. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
